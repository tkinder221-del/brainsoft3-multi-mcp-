# Set all real values only in Manufact environment variables; never commit secrets.
GATEWAY_API_KEY=replace-with-long-random-secret
PORT=8000
# JSON object keyed by alias; each entry has url and optional env-var name for bearer or x-api-key auth.
# Example: {"prompts":{"url":"https://prompts.brainsoft3.dpdns.org/api/mcp?users=brainsoft3admin","auth_env":"PROMPTS_API_KEY","auth_header":"x-api-key"}}
MCP_SERVERS_JSON={}
PROMPTS_API_KEY=
# Remote tool execution is OFF by default. Enable only after reviewing upstream permissions.
ALLOW_REMOTE_CALLS=false
# Optional comma-separated exact allowed tool names, e.g. list_my_bots,get_bot,get_skill
ALLOWED_REMOTE_TOOLS=
